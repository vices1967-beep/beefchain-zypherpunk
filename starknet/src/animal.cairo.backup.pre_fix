        fn verify_zec_sale_with_proof(
            ref self: ContractState,
            animal_id: u128,
            proof_data: Array<felt252>,
            public_inputs: Array<felt252>,
        ) -> felt252 {
            let caller = get_caller_address();
            assert!(
                self.access_control.has_role(PRODUCER_ROLE, caller),
                "AccessControl: missing PRODUCER_ROLE",
            );
            let owner = self.animal_core.get_owner_of(animal_id);
            assert!(owner == caller, "Not owner of animal");

            self.garaga_proofs.verify_zec_sale_with_proof(animal_id, proof_data, public_inputs)
        }

        fn verify_price_with_proof(
            ref self: ContractState,
            animal_id: u128,
            proof_data: Array<felt252>,
            public_inputs: Array<felt252>,
        ) -> felt252 {
            let caller = get_caller_address();
            assert!(
                self.access_control.has_role(PRODUCER_ROLE, caller),
                "AccessControl: missing PRODUCER_ROLE",
            );
            let owner = self.animal_core.get_owner_of(animal_id);
            assert!(owner == caller, "Not owner of animal");

            self.garaga_proofs.verify_price_with_proof(animal_id, proof_data, public_inputs)
        }

        fn execute_private_transfer_with_proof(
            ref self: ContractState,
            animal_id: u128,
            proof_data: Array<felt252>,
            public_inputs: Array<felt252>,
        ) -> felt252 {
            let caller = get_caller_address();
            assert!(
                self.access_control.has_role(PRODUCER_ROLE, caller),
                "AccessControl: missing PRODUCER_ROLE",
            );
            let owner = self.animal_core.get_owner_of(animal_id);
            assert!(owner == caller, "Not owner of animal");

            // Decode Garaga public inputs: (from_zk, to_zk, animal_id, price_proof_hash)
            let from_zk = if public_inputs.len() > 0 {
                *public_inputs.at(0)
            } else {
                0
            };

            let to_zk = if public_inputs.len() > 1 {
                *public_inputs.at(1)
            } else {
                0
            };

            let transfer_animal_id = if public_inputs.len() > 2 {
                (*public_inputs.at(2)).try_into().unwrap_or(0)
            } else {
                0
            };

            let price_proof_hash = if public_inputs.len() > 3 {
                *public_inputs.at(3)
            } else {
                0
            };

            assert!(transfer_animal_id == animal_id, "Animal ID mismatch");

            // Ensure the referenced price proof was previously verified via Garaga
            let price_verification = self
                .garaga_proofs
                .get_price_verification_proof(price_proof_hash);
            assert!(price_verification.verified, "Price proof not verified");
            let price_range = price_verification.price_range;

            // Verify and persist the private transfer proof itself
            let proof_hash = self
                .garaga_proofs
                .execute_private_transfer_with_proof(animal_id, proof_data, public_inputs);

            // Reuse the privacy-aware transfer logic, gating it behind the
            // Garaga-verified price range.
            let demo_price_proof: felt252 = 'VALID_PROOF_DEMO';
            let _ = self
                .private_transfer_animal(
                    animal_id,
                    to_zk,
                    demo_price_proof,
                    price_range.min_price,
                    price_range.max_price,
                );

            proof_hash
        }

