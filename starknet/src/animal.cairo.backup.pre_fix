        fn get_animal_full_history(self: @ContractState, animal_id: u128) -> Array<felt252> {
            let count = self.audit_analytics.animal_history_count.read(animal_id);
            let mut history = ArrayTrait::new();
            let mut index: u32 = 0;
            while index < count {
                let event = self.audit_analytics.animal_history_at_index.read((animal_id, index));
                history.append(event);
                index += 1;
            };
            history
        }

        fn get_cut_full_history(
            self: @ContractState, animal_id: u128, cut_id: u128,
        ) -> Array<felt252> {
            let count = self.audit_analytics.cut_history_count.read((animal_id, cut_id));
            let mut history = ArrayTrait::new();
            let mut index: u32 = 0;
            while index < count {
                let event = self
                    .audit_analytics
                    .cut_history_at_index
                    .read((animal_id, cut_id, index));
                history.append(event);
                index += 1;
            };
            history
        }

        fn get_batch_audit_trail(self: @ContractState, batch_id: u128) -> Array<felt252> {
            let count = self.audit_analytics.batch_audit_count.read(batch_id);
            let mut audit_trail = ArrayTrait::new();
