                audit_trail.append(event);
                index += 1;
            };
            audit_trail
        }

        fn generate_sustainability_report(self: @ContractState, animal_id: u128) -> Array<felt252> {
            let mut report = ArrayTrait::new();

            let animal = self.animal_core.get_animal_data(animal_id);
            let iot_count = self.telemetry.get_iot_history_count(animal_id);

            // Legacy-inspired carbon footprint calculation
            let base_footprint: u128 = animal.weight * 25;
            let iot_impact: u128 = (iot_count * 2).into();
            let carbon_footprint = base_footprint + iot_impact;

            let producer = animal.owner;
            let producer_info = self.access_control.get_participant_info(producer);

            report.append('=== REP DE SOSTENIBILIDAD ===');
            report.append('Animal ID: ' + animal_id.into());
            report.append('Huella de Carbono: ' + carbon_footprint.into() + ' unidades CO2');
            report.append('Peso del Animal: ' + animal.weight.into() + ' kg');
            report.append('Raza: ' + animal.breed.into());

            let estimated_water_usage: u128 = animal.weight * 150;
            report.append('Uso de Agua Estimado: ' + estimated_water_usage.into() + ' litros');

            report.append('Productor: ' + producer_info.name);

            report
        }

        fn get_carbon_footprint_estimate(self: @ContractState, animal_id: u128) -> u128 {
            let animal = self.animal_core.get_animal_data(animal_id);
            let iot_count = self.telemetry.get_iot_history_count(animal_id);

            let base_footprint: u128 = animal.weight * 25;
            let iot_impact: u128 = (iot_count * 2).into();

            base_footprint + iot_impact
        }

        fn get_supply_chain_efficiency(self: @ContractState, producer: ContractAddress) -> u128 {
            let animals = self.animal_core.get_animals_by_owner(producer);
            if animals.len() == 0 {
                return 0;
            }

            let now = get_block_timestamp();
            let mut total_eff: u128 = 0;
            let mut count: u128 = 0;

            let mut index: u32 = 0;
            while index < animals.len() {
                let animal_id = *animals.at(index);
                let animal = self.animal_core.get_animal_data(animal_id);

                // Only consider certified animals (status >= 2)
                if animal.status >= 2 {
                    let processing_time = now - animal.birth_date;
                    total_eff += processing_time.into();
                    count += 1;
                }

                index += 1;
            };

            if count > 0 {
                total_eff / count
            } else {
                0
            }
        }
    }

    // ============ FUNCIONES AUXILIARES ============
    #[external(v0)]
    fn get_total_animals(self: @ContractState) -> u128 {
        self.animal_core.total_supply.read()
    }

    #[external(v0)]
    fn is_producer(self: @ContractState, account: ContractAddress) -> bool {
        self.access_control.has_role(PRODUCER_ROLE, account)
    }

    #[external(v0)]
    fn get_garaga_config(self: @ContractState) -> (ContractAddress, ContractAddress, ContractAddress) {
        (
            self.garaga_proofs.zec_sale_verifier.read(),
            self.garaga_proofs.private_transfer_verifier.read(),
            self.garaga_proofs.price_verification_verifier.read()
        )
    }
}