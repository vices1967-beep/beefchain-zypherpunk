        }

        fn certify_animal(
            ref self: ContractState, animal_id: u128, certification_data: CertificationData,
        ) {
            let animal = self.animal_core.get_animal_data(animal_id);
            assert!(animal.status >= 1, "Animal must be processed");
            assert!(!self.health.is_quarantined(animal_id), "Animal in quarantine");
            self.animal_core.set_animal_status(animal_id, 2);
            self.certification.certify_animal(animal_id, certification_data);
        }

        fn certify_cut(ref self: ContractState, animal_id: u128, cut_id: u128) {
            assert!(self.certification.is_animal_certified(animal_id), "Animal must be certified");
            self.processing.certify_cut(animal_id, cut_id);
            self.certification.certify_cut(animal_id, cut_id);
        }

        fn certify_batch(
            ref self: ContractState, batch_id: u128, certification_data: CertificationData,
        ) {
            let (_batch, animal_ids) = self.processing.get_batch_info(batch_id);
            let mut index: u32 = 0;
            while index < animal_ids.len() {
                let animal_id = *animal_ids.at(index);
                let animal = self.animal_core.get_animal_data(animal_id);
                assert!(animal.status >= 1, "Animal must be processed");
                assert!(!self.health.is_quarantined(animal_id), "Animal in quarantine");
                self.animal_core.set_animal_status(animal_id, 2);
                index += 1;
            };
            self.certification.certify_batch(batch_id, animal_ids, certification_data);
        }

        fn revoke_certification(ref self: ContractState, animal_id: u128, reason: felt252) {
            self.certification.revoke_certification(animal_id, reason);
        }

