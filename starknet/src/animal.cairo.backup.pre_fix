        fn private_transfer_animal(
            ref self: ContractState,
            animal_id: u128,
            to_zk_hash: felt252,
            price_proof: felt252,
            min_price: u128,
            max_price: u128,
        ) -> felt252 {
            let caller = get_caller_address();
            let animal = self.animal_core.get_animal_data(animal_id);
            let zero_address: ContractAddress = 0.try_into().unwrap();
            assert!(animal.owner != zero_address, "Animal does not exist");
            assert!(!self.health.is_quarantined(animal_id), "Animal in quarantine");

            let privacy_data = self.privacy.get_privacy_data(animal_id);
            let caller_zk = self.privacy.get_zk_identity(caller);
            assert!(
                privacy_data.current_owner_zk_hash == caller_zk, "Not owner or privacy mismatch",
            );
            assert!(privacy_data.is_private_mode, "Animal not in private mode");

            let to_address = self.privacy.resolve_account_from_zk_hash(to_zk_hash);
            assert!(to_address != zero_address, "Unknown recipient ZK identity");

            self.animal_core.transfer_animal(to_address, animal_id);
            self
                .privacy
                .record_private_transfer(
                    animal_id, to_address, caller_zk, to_zk_hash, price_proof, min_price, max_price,
                )
        }

