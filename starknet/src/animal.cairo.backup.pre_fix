        fn transfer_cut_to_exporter(
            ref self: ContractState, animal_id: u128, cut_id: u128, exporter: ContractAddress,
        ) {
            let caller = get_caller_address();
            let cut_owner = self.processing.get_cut_owner(animal_id, cut_id);
            assert!(cut_owner == caller, "Not the owner of this cut");
            self.processing.transfer_cut(animal_id, cut_id, caller, exporter);
        }

        fn batch_transfer_cuts(
            ref self: ContractState,
            animal_id: u128,
            cut_ids: Array<u128>,
            exporter: ContractAddress,
        ) {
            let caller = get_caller_address();
            let mut index: u32 = 0;
            while index < cut_ids.len() {
                let cut_id = *cut_ids.at(index);
                let cut_owner = self.processing.get_cut_owner(animal_id, cut_id);
                assert!(cut_owner == caller, "Not the owner of this cut");
                self.processing.transfer_cut(animal_id, cut_id, caller, exporter);
                index += 1;
            }
        }

        fn batch_transfer_cuts_for_batch(
            ref self: ContractState, batch_id: u128, exporter: ContractAddress,
        ) {
            let caller = get_caller_address();
            let animal_ids = self.processing.get_animals_in_batch(batch_id);
            let mut i: u32 = 0;
            while i < animal_ids.len() {
                let animal_id = *animal_ids.at(i);
                let num_cuts = self.processing.get_cut_count(animal_id);
                let mut cut_id: u128 = 1;
                while cut_id <= num_cuts {
                    let cut_owner = self.processing.get_cut_owner(animal_id, cut_id);
                    if cut_owner == caller {
                        self.processing.transfer_cut(animal_id, cut_id, caller, exporter);
                    }
                    cut_id += 1;
                };
                i += 1;
            }
        }

