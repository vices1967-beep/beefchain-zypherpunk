// animal.cairo - Contrato principal Animal
// Este archivo debe ser un módulo completo con #[starknet::contract]

#[starknet::contract]
mod Animal {
    use core::array::ArrayTrait;
    use starknet::{ContractAddress, get_caller_address};
    
    use crate::access::roles::PRODUCER_ROLE;
    use crate::components::access_control::{AccessControlComponent, IAccessControlComponent};
    use crate::components::animal_core::{AnimalCoreComponent, IAnimalCore};
    use crate::components::garaga_proofs::{GaragaProofsComponent, IGaragaProofsComponent};
    
    // Componentes
    component!(path: AnimalCoreComponent, storage: animal_core, event: AnimalCoreEvent);
    component!(path: AccessControlComponent, storage: access_control, event: AccessControlEvent);
    component!(path: GaragaProofsComponent, storage: garaga_proofs, event: GaragaProofsEvent);
    
    #[storage]
    struct Storage {
        #[substorage(v0)]
        animal_core: AnimalCoreComponent::Storage,
        #[substorage(v0)]
        access_control: AccessControlComponent::Storage,
        #[substorage(v0)]
        garaga_proofs: GaragaProofsComponent::Storage,
    }
    
    #[event]
    #[derive(Drop, starknet::Event)]
    enum Event {
        AnimalCoreEvent: AnimalCoreComponent::Event,
        AccessControlEvent: AccessControlComponent::Event,
        GaragaProofsEvent: GaragaProofsComponent::Event,
    }
    
    // Interface (dentro del módulo)
    #[starknet::interface]
    trait IAnimal<TContractState> {
        // Funciones ZK
        fn verify_zec_sale_with_proof(
            ref self: TContractState,
            animal_id: u128,
            proof_data: Array<felt252>,
            public_inputs: Array<felt252>,
        ) -> felt252;
        
        fn verify_price_with_proof(
            ref self: TContractState,
            animal_id: u128,
            proof_data: Array<felt252>,
            public_inputs: Array<felt252>,
        ) -> felt252;
        
        fn execute_private_transfer_with_proof(
            ref self: TContractState,
            animal_id: u128,
            proof_data: Array<felt252>,
            public_inputs: Array<felt252>,
        ) -> felt252;
        
        fn link_animal_to_zec_sale(
            ref self: TContractState,
            animal_id: u128,
            zec_sale_proof_hash: felt252
        ) -> bool;
    }
    
    // Implementación con #[abi(embed_v0)]
    #[abi(embed_v0)]
    impl AnimalImpl of super::IAnimal<ContractState> {
        fn link_animal_to_zec_sale(
            ref self: ContractState,
            animal_id: u128,
            zec_sale_proof_hash: felt252,
        ) -> bool {
            let caller = get_caller_address();
            assert!(
                self.access_control.has_role(PRODUCER_ROLE, caller),
                "AccessControl: missing PRODUCER_ROLE",
            );
            let owner = self.animal_core.get_owner_of(animal_id);
            assert!(owner == caller, "Not owner of animal");

            self.garaga_proofs.link_animal_to_zec_sale(animal_id, zec_sale_proof_hash)
        }
        
        fn verify_zec_sale_with_proof(
            ref self: ContractState,
            animal_id: u128,
            proof_data: Array<felt252>,
            public_inputs: Array<felt252>,
        ) -> felt252 {
            let caller = get_caller_address();
            assert!(
                self.access_control.has_role(PRODUCER_ROLE, caller),
                "AccessControl: missing PRODUCER_ROLE",
            );
            let owner = self.animal_core.get_owner_of(animal_id);
            assert!(owner == caller, "Not owner of animal");

            self.garaga_proofs.verify_zec_sale_with_proof(animal_id, proof_data, public_inputs)
        }
        
        fn verify_price_with_proof(
            ref self: ContractState,
            animal_id: u128,
            proof_data: Array<felt252>,
            public_inputs: Array<felt252>,
        ) -> felt252 {
            let caller = get_caller_address();
            assert!(
                self.access_control.has_role(PRODUCER_ROLE, caller),
                "AccessControl: missing PRODUCER_ROLE",
            );
            let owner = self.animal_core.get_owner_of(animal_id);
            assert!(owner == caller, "Not owner of animal");

            self.garaga_proofs.verify_price_with_proof(animal_id, proof_data, public_inputs)
        }
        
        fn execute_private_transfer_with_proof(
            ref self: ContractState,
            animal_id: u128,
            proof_data: Array<felt252>,
            public_inputs: Array<felt252>,
        ) -> felt252 {
            let caller = get_caller_address();
            assert!(
                self.access_control.has_role(PRODUCER_ROLE, caller),
                "AccessControl: missing PRODUCER_ROLE",
            );
            let owner = self.animal_core.get_owner_of(animal_id);
            assert!(owner == caller, "Not owner of animal");

            self.garaga_proofs.execute_private_transfer_with_proof(animal_id, proof_data, public_inputs)
        }
    }
    
    // Funciones adicionales con #[external(v0)]
    #[external(v0)]
    fn configure_garaga_verifiers(
        ref self: ContractState,
        zec_sale_verifier: ContractAddress,
        private_transfer_verifier: ContractAddress,
        price_verification_verifier: ContractAddress,
    ) {
        self.garaga_proofs.configure_garaga_verifiers(
            zec_sale_verifier,
            private_transfer_verifier,
            price_verification_verifier
        );
    }
    
    #[external(v0)]
    fn get_owner_of(
        self: @ContractState,
        animal_id: u128
    ) -> ContractAddress {
        self.animal_core.get_owner_of(animal_id)
    }
    
    #[external(v0)]
    fn has_role(
        self: @ContractState,
        role: felt252,
        account: ContractAddress
    ) -> bool {
        self.access_control.has_role(role, account)
    }
    
    #[external(v0)]
    fn create_animal_simple(
        ref self: ContractState,
        breed: u128
    ) -> u128 {
        self.animal_core.create_animal_simple(breed)
    }
}
//! Contrato principal Animal con funcionalidades ZK

// ============ IMPORTS ============
use core::array::Array;
use starknet::ContractAddress;
use crate::types::animal::{
    AnimalBatchData, AnimalData, CertificationData, ExportData, MeatCutData, PriceRange,
};
use crate::types::participant::ParticipantInfo;
use crate::types::privacy::PrivacyDashboard;
use crate::types::telemetry::{IoTReading, PublicConsumerData, QRData};
use crate::types::zk_proofs::{PriceVerificationProof, PrivateTransferProof, ZecSaleProof};

// ============ INTERFACE ============
/// @title Animal
/// @notice Principal Starknet contract that composes the modular components
/// @dev Starts with AnimalCoreComponent and will integrate others as they land
#[starknet::interface]
pub trait IAnimal<TContractState> {
    // Animal Core mutating commands
    fn create_animal(
        ref self: TContractState,
        metadata_hash: felt252,
        breed: u128,
        birth_date: u64,
        weight: u128,
    ) -> u128;

    fn create_animal_simple(ref self: TContractState, breed: u128) -> u128;

    fn update_animal_weight(ref self: TContractState, animal_id: u128, new_weight: u128);

    fn transfer_animal(ref self: TContractState, to: ContractAddress, animal_id: u128);

    fn transfer_animal_to_processing_facility(
        ref self: TContractState, animal_id: u128, processing_facility: ContractAddress,
    );

    // Health Component commands
    fn authorize_veterinarian_for_animal(
        ref self: TContractState, veterinarian: ContractAddress, animal_id: u128,
    );

    fn revoke_veterinarian_authorization(
        ref self: TContractState, veterinarian: ContractAddress, animal_id: u128,
    );

    fn add_health_record(
        ref self: TContractState,
        animal_id: u128,
        diagnosis: felt252,
        treatment: felt252,
        vaccination: felt252,
    );

    fn quarantine_animal(ref self: TContractState, animal_id: u128, reason: felt252);

    fn clear_quarantine(ref self: TContractState, animal_id: u128);

    // Certification Component commands
    fn certify_animal(
        ref self: TContractState, animal_id: u128, certification_data: CertificationData,
    );

    fn certify_cut(ref self: TContractState, animal_id: u128, cut_id: u128);

    fn certify_batch(
        ref self: TContractState, batch_id: u128, certification_data: CertificationData,
    );

    fn revoke_certification(ref self: TContractState, animal_id: u128, reason: felt252);

    // Processing Component commands
    fn create_batch(ref self: TContractState, animal_ids: Array<u128>) -> u128;

    fn add_animals_to_batch(ref self: TContractState, batch_id: u128, animal_ids: Array<u128>);

    fn transfer_batch_to_processor(
        ref self: TContractState, batch_id: u128, processor: ContractAddress,
    );

    fn process_animal(ref self: TContractState, animal_id: u128);

    fn process_batch(ref self: TContractState, batch_id: u128);

    fn create_cut(ref self: TContractState, animal_id: u128, cut_type: u128, weight: u128) -> u128;

    fn create_cuts_for_batch(
        ref self: TContractState, batch_id: u128, cut_types: Array<u128>, cut_weights: Array<u128>,
    ) -> Array<u128>;

    // Export Component commands
    fn prepare_export_batch(
        ref self: TContractState,
        animal_ids: Array<u128>,
        destination_country: felt252,
        container_id: felt252,
    ) -> u128;

    fn confirm_export(ref self: TContractState, batch_id: u128, export_permit: felt252);

    fn update_export_temperature(ref self: TContractState, batch_id: u128, temperature: i32);

    fn transfer_cut_to_exporter(
        ref self: TContractState, animal_id: u128, cut_id: u128, exporter: ContractAddress,
    );

    fn batch_transfer_cuts(
        ref self: TContractState, animal_id: u128, cut_ids: Array<u128>, exporter: ContractAddress,
    );

    fn batch_transfer_cuts_for_batch(
        ref self: TContractState, batch_id: u128, exporter: ContractAddress,
    );

    // Privacy Component commands
    fn enable_private_mode(ref self: TContractState, animal_id: u128);

    fn disable_private_mode(ref self: TContractState, animal_id: u128);

    fn private_transfer_animal(
        ref self: TContractState,
        animal_id: u128,
        to_zk_hash: felt252,
        price_proof: felt252,
        min_price: u128,
        max_price: u128,
    ) -> felt252;

    fn get_privacy_dashboard(self: @TContractState, animal_id: u128) -> PrivacyDashboard;

    fn get_zk_identity(self: @TContractState, account: ContractAddress) -> felt252;

    fn register_zk_identity(ref self: TContractState, zk_hash: felt252);

    fn verify_proof_status(self: @TContractState, proof_hash: felt252) -> (bool, PriceRange);

    // Participant & Role Management
    fn register_participant(
        ref self: TContractState, role: felt252, name: felt252, metadata: felt252,
    );

    fn update_participant_info(ref self: TContractState, name: felt252, metadata: felt252);

    fn get_participant_info(self: @TContractState, account: ContractAddress) -> ParticipantInfo;

    fn grant_role(ref self: TContractState, role: felt252, account: ContractAddress);

    fn revoke_role(ref self: TContractState, role: felt252, account: ContractAddress);

    fn renounce_role(ref self: TContractState, role: felt252);

    fn has_role(self: @TContractState, role: felt252, account: ContractAddress) -> bool;

    fn get_role_admin(self: @TContractState, role: felt252) -> felt252;

    fn set_role_admin(ref self: TContractState, role: felt252, admin_role: felt252);

    fn get_role_member_count(self: @TContractState, role: felt252) -> u32;

    fn get_role_member_at_index(
        self: @TContractState, role: felt252, index: u32,
    ) -> ContractAddress;

    fn get_all_role_members(self: @TContractState, role: felt252) -> Array<ContractAddress>;

    // Telemetry & QR helpers
    fn record_iot_reading(ref self: TContractState, animal_id: u128, reading: IoTReading);

    fn get_latest_iot_reading(
        self: @TContractState, animal_id: u128, reading_type: felt252,
    ) -> IoTReading;

    fn get_iot_history_count(self: @TContractState, animal_id: u128) -> u32;

    fn generate_qr_for_cut(ref self: TContractState, animal_id: u128, cut_id: u128) -> felt252;

    fn generate_qr_for_animal(ref self: TContractState, animal_id: u128) -> felt252;

    fn generate_qr_for_batch(ref self: TContractState, batch_id: u128) -> felt252;

    fn verify_qr_authenticity(self: @TContractState, qr_hash: felt252) -> bool;

    fn get_qr_data(self: @TContractState, qr_hash: felt252) -> QRData;

    fn generate_authenticity_proof(ref self: TContractState, qr_hash: felt252) -> felt252;

    fn get_public_consumer_data(self: @TContractState, qr_hash: felt252) -> PublicConsumerData;

    fn get_verified_consumer_data(
        self: @TContractState, qr_hash: felt252, authenticity_proof: felt252,
    ) -> (PublicConsumerData, bool, felt252);

    // View helpers
    fn get_export_data(self: @TContractState, batch_id: u128) -> ExportData;

    fn get_animal_data(self: @TContractState, animal_id: u128) -> AnimalData;

    fn get_certification_data(self: @TContractState, animal_id: u128) -> CertificationData;

    fn get_owner_of(self: @TContractState, animal_id: u128) -> ContractAddress;

    fn get_token_uri(self: @TContractState, animal_id: u128) -> felt252;

    fn get_num_meat_cuts(self: @TContractState, animal_id: u128) -> u128;

    fn is_quarantined(self: @TContractState, animal_id: u128) -> bool;

    fn is_authorized_veterinarian(
        self: @TContractState, animal_id: u128, veterinarian: ContractAddress,
    ) -> bool;

    fn get_animals_by_owner(self: @TContractState, producer: ContractAddress) -> Array<u128>;

    fn get_owner_statistics(self: @TContractState, producer: ContractAddress) -> (u32, u32, u128);

    fn get_system_statistics(self: @TContractState) -> (u128, u128, u128, u128, u128, u128, u128);

    fn get_role_statistics(self: @TContractState) -> (u32, u32, u32, u32, u32, u32, u32);

    fn get_batch_info(self: @TContractState, batch_id: u128) -> (AnimalBatchData, Array<u128>);

    fn get_batches_by_owner(self: @TContractState, owner: ContractAddress) -> Array<u128>;

    fn get_animals_in_batch(self: @TContractState, batch_id: u128) -> Array<u128>;

    fn get_batch_for_animal(self: @TContractState, animal_id: u128) -> u128;

    fn get_cut_owner(self: @TContractState, animal_id: u128, cut_id: u128) -> ContractAddress;

    fn get_cut_info(self: @TContractState, animal_id: u128, cut_id: u128) -> MeatCutData;

    fn get_animal_overview(self: @TContractState, animal_id: u128) -> (AnimalData, u128, felt252);

    // Garaga ZK proof functions
    fn verify_zec_sale_with_proof(
        ref self: TContractState,
        animal_id: u128,
        proof_data: Array<felt252>,
        public_inputs: Array<felt252>,
    ) -> felt252;

    fn verify_price_with_proof(
        ref self: TContractState,
        animal_id: u128,
        proof_data: Array<felt252>,
        public_inputs: Array<felt252>,
    ) -> felt252;

    fn execute_private_transfer_with_proof(
        ref self: TContractState,
        animal_id: u128,
        proof_data: Array<felt252>,
        public_inputs: Array<felt252>,
    ) -> felt252;

    fn get_zec_sale_proof(self: @TContractState, proof_hash: felt252) -> ZecSaleProof;

    fn get_price_verification_proof(
        self: @TContractState, proof_hash: felt252,
    ) -> PriceVerificationProof;

    fn get_private_transfer_proof(
        self: @TContractState, proof_hash: felt252,
    ) -> PrivateTransferProof;

    fn link_animal_to_zec_sale(
        ref self: TContractState, animal_id: u128, zec_sale_proof_hash: felt252,
    ) -> bool;

    fn is_animal_zec_verified(self: @TContractState, animal_id: u128) -> bool;

    fn get_animal_zec_proof(self: @TContractState, animal_id: u128) -> felt252;

    fn get_zec_sales_verified_count(self: @TContractState) -> u128;

    fn get_price_verifications_count(self: @TContractState) -> u128;

    fn get_private_transfers_executed_count(self: @TContractState) -> u128;

    fn get_animal_full_history(self: @TContractState, animal_id: u128) -> Array<felt252>;

    fn get_cut_full_history(self: @TContractState, animal_id: u128, cut_id: u128) -> Array<felt252>;

    fn get_batch_audit_trail(self: @TContractState, batch_id: u128) -> Array<felt252>;

    fn generate_sustainability_report(self: @TContractState, animal_id: u128) -> Array<felt252>;

    fn get_carbon_footprint_estimate(self: @TContractState, animal_id: u128) -> u128;

    fn get_supply_chain_efficiency(self: @TContractState, producer: ContractAddress) -> u128;
}

// ============ CONTRACT ============
#[starknet::contract]
mod AnimalContract {
    use core::array::ArrayTrait;
    use core::traits::TryInto;
    use starknet::{ContractAddress, get_block_timestamp, get_caller_address};
    
    // Componentes
    use super::IAnimal;
    use crate::access::roles::PRODUCER_ROLE;
    use crate::components::access_control::AccessControlComponent;
    use crate::components::animal_core::AnimalCoreComponent;
    use crate::components::audit_analytics::AuditAnalyticsComponent;
    use crate::components::certification::CertificationComponent;
    use crate::components::export::ExportComponent;
    use crate::components::garaga_proofs::GaragaProofsComponent;
    use crate::components::health::HealthComponent;
    use crate::components::privacy::PrivacyComponent;
    use crate::components::processing::ProcessingComponent;
    use crate::components::telemetry::TelemetryComponent;
    
    // Tipos
    use crate::types::animal::{
        AnimalBatchData, AnimalData, CertificationData, ExportData, MeatCutData, PriceRange,
    };
    use crate::types::participant::ParticipantInfo;
    use crate::types::privacy::PrivacyDashboard;
    use crate::types::telemetry::{IoTReading, PublicConsumerData, QRData};
    use crate::types::zk_proofs::{PriceVerificationProof, PrivateTransferProof, ZecSaleProof};

    // ============ COMPONENTES ============
    component!(path: AnimalCoreComponent, storage: animal_core, event: AnimalCoreEvent);
    component!(path: HealthComponent, storage: health, event: HealthEvent);
    component!(path: ProcessingComponent, storage: processing, event: ProcessingEvent);
    component!(path: CertificationComponent, storage: certification, event: CertificationEvent);
    component!(path: ExportComponent, storage: export, event: ExportEvent);
    component!(path: PrivacyComponent, storage: privacy, event: PrivacyEvent);
    component!(path: TelemetryComponent, storage: telemetry, event: TelemetryEvent);
    component!(path: AccessControlComponent, storage: access_control, event: AccessControlEvent);
    component!(path: GaragaProofsComponent, storage: garaga_proofs, event: GaragaProofsEvent);
    component!(path: AuditAnalyticsComponent, storage: audit_analytics, event: AuditAnalyticsEvent);

    // ============ STORAGE ============
    #[storage]
    struct Storage {
        #[substorage(v0)]
        animal_core: AnimalCoreComponent::Storage,
        #[substorage(v0)]
        health: HealthComponent::Storage,
        #[substorage(v0)]
        processing: ProcessingComponent::Storage,
        #[substorage(v0)]
        certification: CertificationComponent::Storage,
        #[substorage(v0)]
        export: ExportComponent::Storage,
        #[substorage(v0)]
        privacy: PrivacyComponent::Storage,
        #[substorage(v0)]
        telemetry: TelemetryComponent::Storage,
        #[substorage(v0)]
        access_control: AccessControlComponent::Storage,
        #[substorage(v0)]
        garaga_proofs: GaragaProofsComponent::Storage,
        #[substorage(v0)]
        audit_analytics: AuditAnalyticsComponent::Storage,
    }

    // ============ EVENTOS ============
    #[event]
    #[derive(Drop, starknet::Event)]
    enum Event {
        #[flat]
        AnimalCoreEvent: AnimalCoreComponent::Event,
        #[flat]
        HealthEvent: HealthComponent::Event,
        #[flat]
        ProcessingEvent: ProcessingComponent::Event,
        #[flat]
        CertificationEvent: CertificationComponent::Event,
        #[flat]
        ExportEvent: ExportComponent::Event,
        #[flat]
        PrivacyEvent: PrivacyComponent::Event,
        #[flat]
        TelemetryEvent: TelemetryComponent::Event,
        #[flat]
        AccessControlEvent: AccessControlComponent::Event,
        #[flat]
        GaragaProofsEvent: GaragaProofsComponent::Event,
        #[flat]
        AuditAnalyticsEvent: AuditAnalyticsComponent::Event,
    }

    // ============ CONSTRUCTOR ============
    #[constructor]
    fn constructor(ref self: ContractState, admin: ContractAddress) {
        // Inicializar access control con admin proporcionado
        self.access_control.initialize(admin);
        
        // Inicializar verificadores Garaga con direcciones cero
        // (Se configurarán después con configure_garaga_verifiers)
        let zero_address: ContractAddress = 0.try_into().unwrap();
        self.garaga_proofs.zec_sale_verifier.write(zero_address);
        self.garaga_proofs.private_transfer_verifier.write(zero_address);
        self.garaga_proofs.price_verification_verifier.write(zero_address);
    }

    // ============ CONFIGURACIÓN GARAGA ============
    #[external(v0)]
    fn configure_garaga_verifiers(
        ref self: ContractState,
        zec_sale_verifier: ContractAddress,
        private_transfer_verifier: ContractAddress,
        price_verification_verifier: ContractAddress
    ) {
        // Solo admin puede configurar
        let caller = get_caller_address();
        assert!(
            self.access_control.has_role('DEFAULT_ADMIN_ROLE', caller),
            "Only admin can configure verifiers"
        );
        
        // Configurar verificadores
        self.garaga_proofs.zec_sale_verifier.write(zec_sale_verifier);
        self.garaga_proofs.private_transfer_verifier.write(private_transfer_verifier);
        self.garaga_proofs.price_verification_verifier.write(price_verification_verifier);
    }

    // ============ IMPLEMENTACIÓN PRINCIPAL ============
    #[abi(embed_v0)]
    impl AnimalImpl of super::IAnimal<ContractState> {
        fn create_animal(
            ref self: ContractState,
            metadata_hash: felt252,
            breed: u128,
            birth_date: u64,
            weight: u128,
        ) -> u128 {
            let animal_id = self
                .animal_core
                .create_animal(metadata_hash, breed, birth_date, weight);
            self.privacy.initialize_privacy_data(animal_id, get_caller_address());
            animal_id
        }

        fn create_animal_simple(ref self: ContractState, breed: u128) -> u128 {
            let animal_id = self.animal_core.create_animal_simple(breed);
            self.privacy.initialize_privacy_data(animal_id, get_caller_address());
            animal_id
        }

        fn update_animal_weight(ref self: ContractState, animal_id: u128, new_weight: u128) {
            self.animal_core.update_animal_weight(animal_id, new_weight);
        }

        fn transfer_animal(ref self: ContractState, to: ContractAddress, animal_id: u128) {
            self.animal_core.transfer_animal(to, animal_id);
        }

        fn transfer_animal_to_processing_facility(
            ref self: ContractState, animal_id: u128, processing_facility: ContractAddress,
        ) {
            self.animal_core.transfer_animal_to_processing_facility(animal_id, processing_facility);
        }

        fn get_animal_data(self: @ContractState, animal_id: u128) -> AnimalData {
            self.animal_core.get_animal_data(animal_id)
        }

        fn get_owner_of(self: @ContractState, animal_id: u128) -> ContractAddress {
            self.animal_core.get_owner_of(animal_id)
        }

        fn get_token_uri(self: @ContractState, animal_id: u128) -> felt252 {
            self.animal_core.get_token_uri(animal_id)
        }

        fn get_num_meat_cuts(self: @ContractState, animal_id: u128) -> u128 {
            self.animal_core.get_num_meat_cuts(animal_id)
        }

        fn is_quarantined(self: @ContractState, animal_id: u128) -> bool {
            self.health.is_quarantined(animal_id)
        }

        fn authorize_veterinarian_for_animal(
            ref self: ContractState, veterinarian: ContractAddress, animal_id: u128,
        ) {
            let caller = get_caller_address();
            let owner = self.animal_core.get_owner_of(animal_id);
            assert!(caller == owner, "Only the animal owner can authorize veterinarians");
            self.health.authorize_veterinarian_for_animal(veterinarian, animal_id);
        }

        fn revoke_veterinarian_authorization(
            ref self: ContractState, veterinarian: ContractAddress, animal_id: u128,
        ) {
            let caller = get_caller_address();
            let owner = self.animal_core.get_owner_of(animal_id);
            assert!(caller == owner, "Only the animal owner can revoke authorizations");
            self.health.revoke_veterinarian_authorization(veterinarian, animal_id);
        }

        fn add_health_record(
            ref self: ContractState,
            animal_id: u128,
            diagnosis: felt252,
            treatment: felt252,
            vaccination: felt252,
        ) {
            let caller = get_caller_address();
            let owner = self.animal_core.get_owner_of(animal_id);
            let is_authorized = self.health.is_authorized_veterinarian(animal_id, caller);
            assert!(is_authorized || owner == caller, "Not authorized for this animal");
            self.health.add_health_record(animal_id, diagnosis, treatment, vaccination);
        }

        fn quarantine_animal(ref self: ContractState, animal_id: u128, reason: felt252) {
            let caller = get_caller_address();
            let owner = self.animal_core.get_owner_of(animal_id);
            let is_authorized = self.health.is_authorized_veterinarian(animal_id, caller);
            assert!(is_authorized || owner == caller, "Not authorized for this animal");
            self.health.quarantine_animal(animal_id, reason);
        }

        fn clear_quarantine(ref self: ContractState, animal_id: u128) {
            let caller = get_caller_address();
            let owner = self.animal_core.get_owner_of(animal_id);
            let is_authorized = self.health.is_authorized_veterinarian(animal_id, caller);
            assert!(is_authorized || owner == caller, "Not authorized for this animal");
            self.health.clear_quarantine(animal_id);
        }

